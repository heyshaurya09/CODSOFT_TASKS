# Step 1: Import Libraries
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# Step 2: Load the Cleaned Dataset
df = pd.read_csv("cleaned_dataset.csv")

print("Dataset Loaded Successfully!\n")

# Step 3: Display First Five Rows
print(df.head())

# Step 4: Display Dataset Information
print("\nDataset Information:")
print(df.info())

# Step 5: Descriptive Statistics
print("\nDescriptive Statistics:")
print(df.describe())

# Step 6: Check Correlation Between Numerical Columns
print("\nCorrelation Matrix:")
print(df.corr(numeric_only=True))

# Step 7: Detect Outliers using Box Plot
plt.figure(figsize=(8,5))
sns.boxplot(x=df["Age"])
plt.title("Box Plot of Age")
plt.show()

# Step 8: Correlation Heatmap
plt.figure(figsize=(8,6))
sns.heatmap(df.corr(numeric_only=True), annot=True, cmap="Blues")
plt.title("Correlation Heatmap")
plt.show()

# Step 9: Business Insights
print("\nBusiness Insights")
print("----------------------------")
print("Total Passengers :", len(df))
print("Average Age :", round(df["Age"].mean(),2))
print("Average Fare :", round(df["Fare"].mean(),2))
print("Highest Fare :", df["Fare"].max())
print("Lowest Fare :", df["Fare"].min())

print("\nTask 2 Completed Successfully!")
