# TASK 1 - DATA CLEANING & PREPROCESSING
# ==========================================

# Step 1: Import Libraries
import pandas as pd

# Step 2: Load the Dataset
df = pd.read_csv("titanic.csv")

print("Dataset Loaded Successfully!\n")

# Step 3: Display First Five Rows
print("First Five Rows:")
print(df.head())

# Step 4: Check Dataset Information
print("\nDataset Information:")
print(df.info())

# Step 5: Check Dataset Shape
print("\nNumber of Rows and Columns:")
print(df.shape)

# Step 6: Check Missing Values
print("\nMissing Values in Each Column:")
print(df.isnull().sum())

# Step 7: Check Duplicate Records
print("\nDuplicate Records:")
print(df.duplicated().sum())

# Step 8: Remove Duplicate Records
df = df.drop_duplicates()

print("\nDuplicate Records Removed!")

# Step 9: Fill Missing Values

# Fill Age column with Median
df["Age"] = df["Age"].fillna(df["Age"].median())

# Fill Embarked column with Mode
df["Embarked"] = df["Embarked"].fillna(df["Embarked"].mode()[0])

# Fill Cabin column with 'Unknown'
df["Cabin"] = df["Cabin"].fillna("Unknown")

print("\nMissing Values Filled!")

# Step 10: Check Data Types
print("\nData Types:")
print(df.dtypes)

# Step 11: Convert Age into Integer
df["Age"] = df["Age"].astype(int)

# Step 12: Check Missing Values Again
print("\nMissing Values After Cleaning:")
print(df.isnull().sum())

# Step 13: Save Cleaned Dataset
df.to_csv("cleaned_dataset.csv", index=False)

print("\nCleaned Dataset Saved Successfully!")

print("\nTask 1 Completed Successfully!")
